# Copie para .env no servidor e preencha. O .env NUNCA vai para o repositório.

# Domínios (sem https://)
SITE_DOMAIN=larinovaisbeauty.com.br
API_DOMAIN=api.larinovaisbeauty.com.br

# Gere com: openssl rand -hex 24   (só letras e números, para não quebrar a connection string)
POSTGRES_PASSWORD=

# Gere com: openssl rand -base64 48   (mínimo 32 bytes)
JWT_KEY=

# Login do Painel Ateliê. Deixe o hash vazio e rode ./set-admin-password.sh (pede a senha sem mostrar e grava o hash aqui)
ADMIN_USERNAME=lari
ADMIN_PASSWORD_HASH=

# Ponto de partida da maquiadora, para a taxa de deslocamento (dado pessoal)
TRAVEL_ORIGIN_LATITUDE=
TRAVEL_ORIGIN_LONGITUDE=

# WhatsApp (vazio = mensagens só no log)
WHATSAPP_API_URL=
WHATSAPP_API_KEY=
WHATSAPP_OWNER_PHONE=5511914834786

# Google Calendar: coloque o JSON da service account em secrets/google-calendar.json
GOOGLE_CALENDAR_ID=
